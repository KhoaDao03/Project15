[Unit]
Description=Project15 isolated read-only public website
After=network.target

[Service]
Type=simple
User=public-web
Group=public-web
WorkingDirectory=/srv/public-web/project15
Environment=PROJECT15_PUBLIC_DATA_DIR=/var/lib/project15-public
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/srv/public-web/project15/.venv/bin/python -m uvicorn public_site:create_app --factory --uds /run/project15-public/http.sock --no-proxy-headers --no-access-log --limit-concurrency 32 --timeout-keep-alive 5
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
UMask=0077
RuntimeDirectory=project15-public
RuntimeDirectoryMode=0755
NoNewPrivileges=true
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateNetwork=true
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
LockPersonality=true
ProtectProc=invisible
ProcSubset=pid
MemoryMax=256M
TasksMax=64
CPUQuota=50%

[Install]
WantedBy=multi-user.target
